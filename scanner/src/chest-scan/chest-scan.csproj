<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>chest-scan</AssemblyName>
    <RootNamespace>ChestScan</RootNamespace>
    <Version>0.1.0</Version>
    <!-- The parser finds its types by reflection, so no trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <!-- Chest Counter's replay reading, used as it is (see ../../THIRD_PARTY_NOTICES.md). -->
    <Compile Include="..\engine\*.cs" />
    <ProjectReference Include="..\..\lib\FortniteReplayReader\FortniteReplayReader.csproj" />
    <!-- The engine reads these two at start-up; the scanner never shows treasure data or release notes. -->
    <EmbeddedResource Include="..\..\content\content.json" LogicalName="content.json" />
    <EmbeddedResource Include="..\..\content\README.md" LogicalName="ReleaseNotes.md" />
  </ItemGroup>
</Project>
